# macOS
.DS_Store

# Xcode - user-specific state (per-developer; causes noisy diffs/conflicts if shared)
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout

# Xcode - build products and derived data
build/
DerivedData/
*.moved-aside
*.hmap
*.ipa
*.dSYM
*.dSYM.zip

# Swift Package Manager - local build artifacts
# (xcshareddata/swiftpm/Package.resolved is intentionally NOT ignored - it's
# shared and pins dependency versions for reproducible builds)
.build/
.swiftpm/
